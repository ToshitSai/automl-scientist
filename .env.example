# =============================================================================
# AI Scientist — environment configuration (EXAMPLE — copy to .env)
# All values below are placeholders. Never commit real secrets.
# =============================================================================

# ------------------------------------------------------------------ database
# PostgreSQL 16 + pgvector — source of truth for all application state.
# Local dev (docker compose up -d):
DATABASE_URL=postgresql://ai_scientist:ai_scientist_dev_password@localhost:5432/ai_scientist
# Production (Vercel): use a managed Postgres with pgvector, e.g. Neon or Supabase:
# DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
#
# Set to 1 to force the legacy JSON-file store (offline dev / hermetic tests):
STORE_DB_DISABLED=0
# Semantic search via pgvector (schema ships vector columns + ivfflat indexes).
PGVECTOR_ENABLED=true

# --------------------------------------------------------------------- Redis
# Cache / job-queue runtime (durable job records live in Postgres; Redis is the
# transport/progress layer). Leave unset to run without Redis.
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------- object storage
# Large files (datasets, model artifacts, reports, uploads) never live in
# Postgres: bytes go to object storage, metadata to the files table.
# Unset = local directory adapter (./object_store) for development.
STORAGE_URL=
STORAGE_BUCKET=ai-scientist
# S3-compatible credentials (MinIO in docker-compose: minioadmin/minioadmin).
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Local adapter root when STORAGE_URL is empty:
STORAGE_LOCAL_ROOT=./object_store

# -------------------------------------------------------------- LLM providers
# First working provider wins; without any, deterministic heuristics are used.
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# ----------------------------------------------------------------- research
OPENALEX_API_KEY=
HF_TOKEN=
MLFLOW_TRACKING_URI=

# ----------------------------------------------------------------- frontend
VITE_API_BASE_URL=
