# AutoML Scientist Environment Variables Configuration
# Place actual secrets in .env (never commit .env to source control)

# LLM Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Literature Search API Key
SEMANTIC_SCHOLAR_API_KEY=

# Database Configuration
DATABASE_URL=postgresql://automl_user:automl_pass@localhost:5432/automl_scientist

# Sandbox Execution Settings
DOCKER_SANDBOX_ENABLED=true
SANDBOX_CPU_LIMIT=2.0
SANDBOX_MEMORY_LIMIT=4g
SANDBOX_TIMEOUT_SECONDS=300

# Backend Configuration
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
