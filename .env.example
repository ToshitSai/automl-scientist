# =============================================================================
# AI Scientist — environment configuration
# Copy this file to `.env` and fill in only the values you need.
# The backend auto-loads `.env` on import (backend/config.py). It never
# requires every key: missing providers fall back gracefully.
# SECURITY: never commit the real `.env`. Keys are server-side only and are
# never returned by any API response or printed to logs.
# =============================================================================

# ---------- LLM PROVIDERS (all optional; first available is used) ----------
# Order of fallback: OpenAI -> Gemini -> Anthropic -> Mistral -> deterministic heuristics.
# If none are set/valid, the app still works using built-in heuristic fallbacks.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# ---------- LITERATURE SEARCH (optional) ----------
# OpenAlex polite-pool email/key. Semantic Scholar is queried keyless (public API).
OPENALEX_API_KEY=your_openalex_api_key_here

# ---------- WEB SEARCH (optional; used by WEB_SEARCH + DEEP_RESEARCH modes) ---
# Provider order: Tavily -> Serper (Google) -> Brave -> keyless DuckDuckGo
# Instant Answers. With no key the keyless fallback is used; if that fails the
# assistant says so honestly instead of inventing current facts.
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here
BRAVE_API_KEY=your_brave_api_key_here

# ---------- HUGGING FACE (optional) ----------
# Only needed for gated/private datasets. Public dataset discovery + download
# work without a token.
HF_TOKEN=your_huggingface_token_here

# ---------- EXPERIMENT TRACKING (optional, best-effort) ----------
# MLflow is contacted over REST with a short timeout; if it is not running the
# app silently continues. Leave unset to disable.
MLFLOW_TRACKING_URI=http://localhost:5000

# ---------- PERSISTENT STORE (optional but REQUIRED for cross-session memory) --
# When DATABASE_URL is set, the store mirrors its state into Postgres so
# conversations, messages, projects and reports survive restarts and are shared
# across serverless instances. On Vercel use a Neon *pooled* connection string
# (host contains "-pooler"); set it as a Vercel env var, never in the frontend.
# Leave unset for local file-based storage (database/research_store.json).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# REDIS_URL is accepted for a future cache backend but is NOT currently used.
REDIS_URL=redis://localhost:6379

# ---------- STORAGE ----------
STORAGE_TYPE=local

# ---------- APPLICATION ----------
APP_ENV=development
LOG_LEVEL=INFO
